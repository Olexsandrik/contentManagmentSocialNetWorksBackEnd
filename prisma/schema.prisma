generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int                 @id @default(autoincrement())
  email      String?             @unique
  name        String
  password   String?
  provider   String?
  avatarUrl  String?             @db.Text
  role       String?
  createdAt  DateTime            @default(now())
  accountId   String?
  posts      SocialMediaPost[]
  reviews    Reviews[]
  tasks      Task[]
  analytics  AnalyticsAI[]
}

model SocialMediaPost {
  id             String                 @id @default(uuid())
  userId         Int
  user           User                   @relation(fields: [userId], references: [id])
  postId         BigInt                 @unique
  caption        String?
  mediaType      String
  mediaUrl       String                 @db.Text
  permalink      String
  timestamp      DateTime
  likeCount      Int
  commentsCount  Int
  createdAt      DateTime              @default(now())
  platform       String
  comments       SocialMediaComment[]
}

model SocialMediaComment {
  id         String             @id @default(uuid())
  postId     BigInt
  post       SocialMediaPost    @relation(fields: [postId], references: [postId])
  commentId  BigInt             @unique
  text       String
  username   String
  timestamp  DateTime
  createdAt  DateTime           @default(now())
}

model Reviews {
  id            String     @id @default(uuid())
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  typeOfReviews String
  topic         String
  messages      String
  createdAt     DateTime   @default(now())
}

model Task {
  id         String     @id @default(uuid())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  name       String
  priority   String
}

model AnalyticsAI {
  id         String     @id @default(uuid())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  dataType   String
  prompt     String
  inputData  Json
  result     String
  createdAt  DateTime   @default(now())
}